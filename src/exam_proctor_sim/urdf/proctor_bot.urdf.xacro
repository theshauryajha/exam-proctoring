<?xml version="1.0"?>
<!-- Differential-drive proctoring robot with a mast-mounted pan/tilt camera. -->
<robot name="proctor_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="cam_width" default="1280"/>
  <xacro:arg name="cam_height" default="720"/>
  <xacro:arg name="cam_fps" default="15"/>

  <xacro:property name="base_radius" value="0.22"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_clearance" value="0.02"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_separation" value="0.40"/>
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="mast_height" value="1.25"/>

  <material name="body_grey"><color rgba="0.85 0.85 0.88 1"/></material>
  <material name="dark"><color rgba="0.12 0.12 0.14 1"/></material>
  <material name="accent"><color rgba="0.95 0.45 0.05 1"/></material>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
  </xacro:macro>
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <!-- ===================== Base ===================== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_clearance + base_height/2}"/>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_clearance + base_height/2}"/>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_clearance + base_height/2}"/>
      <mass value="8.0"/>
      <xacro:cylinder_inertia m="8.0" r="${base_radius}" h="${base_height}"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <visual>
        <origin rpy="${-pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="${-pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <xacro:cylinder_inertia m="0.3" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_separation/2}"/>
  <xacro:wheel side="right" y="${-wheel_separation/2}"/>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}"/>
    </joint>
    <gazebo reference="${name}_caster">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="front" x="0.16"/>
  <xacro:caster name="rear" x="-0.16"/>

  <!-- ===================== Mast ===================== -->
  <link name="mast_link">
    <visual>
      <origin xyz="0 0 ${mast_height/2}"/>
      <geometry><cylinder radius="0.02" length="${mast_height}"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${mast_height/2}"/>
      <geometry><cylinder radius="0.02" length="${mast_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${mast_height/2}"/>
      <mass value="0.5"/>
      <xacro:cylinder_inertia m="0.5" r="0.02" h="${mast_height}"/>
    </inertial>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="0 0 ${base_clearance + base_height}"/>
  </joint>

  <!-- ===================== Pan / tilt head ===================== -->
  <link name="camera_pan_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.045" length="0.05"/></geometry>
      <material name="accent"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="0.2"/>
      <xacro:cylinder_inertia m="0.2" r="0.045" h="0.05"/>
    </inertial>
  </link>
  <joint name="camera_pan_joint" type="continuous">
    <parent link="mast_link"/>
    <child link="camera_pan_link"/>
    <origin xyz="0 0 ${mast_height}"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05"/>
  </joint>

  <link name="camera_tilt_link">
    <visual>
      <geometry><box size="0.03 0.08 0.03"/></geometry>
      <material name="dark"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <xacro:box_inertia m="0.1" x="0.03" y="0.08" z="0.03"/>
    </inertial>
  </link>
  <!-- Positive tilt pitches the camera down. -->
  <joint name="camera_tilt_joint" type="revolute">
    <parent link="camera_pan_link"/>
    <child link="camera_tilt_link"/>
    <origin xyz="0 0 0.08"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="1.3" effort="10" velocity="3"/>
    <dynamics damping="0.05"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.12 0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="0.03 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="0.018" length="0.02"/></geometry>
      <material name="accent"/>
    </visual>
    <inertial>
      <mass value="0.15"/>
      <xacro:box_inertia m="0.15" x="0.05" y="0.12" z="0.05"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="0.04 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.04 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ===================== Gazebo sensors & systems ===================== -->
  <gazebo reference="camera_link">
    <sensor name="proctor_camera" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>$(arg cam_fps)</update_rate>
      <topic>/proctor/camera/image</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera name="proctor_cam">
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>$(arg cam_width)</width>
          <height>$(arg cam_height)</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>30</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <min_linear_acceleration>-0.8</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <topic>/model/proctor_bot/cmd_vel</topic>
      <!-- Wheel odometry kept off /tf; ground-truth odometry below is used instead. -->
      <odom_topic>/model/proctor_bot/wheel_odom</odom_topic>
      <tf_topic>/model/proctor_bot/wheel_odom_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/model/proctor_bot/odometry</odom_topic>
      <tf_topic>/model/proctor_bot/odometry_tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/proctor_bot/joint_states</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>camera_pan_joint</joint_name>
      <topic>/model/proctor_bot/camera_pan_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>12</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>camera_tilt_joint</joint_name>
      <topic>/model/proctor_bot/camera_tilt_cmd</topic>
      <initial_position>0.3</initial_position>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>12</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <cmd_max>3</cmd_max>
      <cmd_min>-3</cmd_min>
    </plugin>
  </gazebo>
</robot>
